# Portal settings (the portal also reads ../webhook_bot/.env for WEBHOOK_SECRET and Telegram)
DJANGO_DEBUG=true
# Comma-separated hosts allowed to serve the portal (use your domain in production)
ALLOWED_HOSTS=*
# Origins allowed to POST forms (add your https domain in production)
CSRF_TRUSTED_ORIGINS=https://*.lhr.life,https://*.ngrok-free.app,http://localhost:8001,http://127.0.0.1:8001
TIME_ZONE=Asia/Karachi
SITE_NAME=AxeAlgo
SUPPORT_EMAIL=

# The ONLY account with admin rights. Register it normally first; every start promotes it and demotes everyone else.
SUPERADMIN_EMAIL=you@example.com

# Shop prices (USD)
PRICE_BOT=20
PRICE_SIGNAL=1
PACK_SIZE=20

# Payment instructions shown at checkout. Leave empty to hide a method. Links (http...) become buttons.
PAYMENT_BANK=
PAYMENT_CRYPTO=
PAYMENT_PAYPAL_LINK=
PAYMENT_STRIPE_LINK=

# Login tokens: signed JWT cookie issued at login, fixed lifetime (default 24 h).
# Generate a secret with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24
