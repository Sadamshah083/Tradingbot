# ── Required ──────────────────────────────────────────────────────────────────
# Long random passphrase. Put the SAME value in the strategy input "Webhook Passphrase".
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Safety switches ───────────────────────────────────────────────────────────
# false = paper mode: every alert is logged to logs/paper_trades.jsonl, no broker is touched.
LIVE=false
# Starting trading mode: false = MANUAL (bot journals + notifies, you trade), true = AUTO (bot places orders).
# Can be switched at runtime from the /panel page; the switch is remembered in logs/mode.json.
AUTO_TRADE=false
# Optional Telegram notifications (signals, bot orders, mode changes). Create a bot with @BotFather,
# then send it a message and read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Django customer portal (../portal). Every signal/exit is forwarded there and delivered to paying customers.
PORTAL_URL=http://127.0.0.1:8001
# Or forward to the Next.js SaaS (../signals-saas) instead - full URL of its webhook (same WEBHOOK_SECRET):
# PORTAL_INGEST_URL=http://127.0.0.1:3000/api/webhook/signal
# paper | oanda | binance_futures   (ignored while LIVE=false)
BROKER=paper
# Which alert opens a position: "signal" (bar close, before TradingView's own fill) or "entry" (TradingView fill).
ACT_ON=signal
# Share (%) of the quantity bracketed with TP1 when the alert carries a tp1. 0 = everything targets TP2.
TP1_SPLIT=0
# Hard cap on quantity per order (units / contracts). 0 = no cap.
MAX_QTY=0
# Comma-separated IPs allowed to call /webhook. TradingView's published webhook IPs:
ALLOWED_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

# TradingView ticker -> broker symbol
SYMBOL_MAP={"XAUUSD":"XAU_USD","BTCUSDT":"BTC/USDT:USDT","BTCUSD":"BTC/USDT:USDT"}

# ── OANDA (gold / forex) ──────────────────────────────────────────────────────
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
# practice | live
OANDA_ENV=practice

# ── Binance USDT-M futures (BTC) ──────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_LEVERAGE=3

LOG_DIR=logs
