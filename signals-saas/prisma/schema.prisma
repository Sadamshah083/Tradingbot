// Prisma schema - PostgreSQL. Models from the specification plus the fields needed for
// TOTP 2FA, Stripe subscriptions, bot settings and runtime settings (webhook secret override).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String?
  role               String    @default("USER") // USER | ADMIN
  status             String    @default("PENDING") // PENDING | APPROVED | BANNED
  subscriptionStatus String    @default("INACTIVE") // INACTIVE | ACTIVE | EXPIRED
  subscriptionExpiry DateTime?
  stripeCustomerId   String?
  stripeSubscriptionId String?
  autoRenew          Boolean   @default(true)
  brokerApiKey       String? // AES-256-GCM encrypted
  totpSecret         String? // AES-256-GCM encrypted, admins only
  totpEnabled        Boolean   @default(false)
  notifyEmail        Boolean   @default(true)
  notifyBrowser      Boolean   @default(true)
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  signals            Signal[]
  messages           Message[]
  conversation       Conversation?
  botConfig          BotConfig?
}

model Signal {
  id         String    @id @default(cuid())
  symbol     String
  direction  String // BUY | SELL
  entry      Float
  stopLoss   Float
  takeProfit Float
  timeframe  String // 5m | 15m | 1h | 4h | 1d
  strategy   String?
  status     String    @default("ACTIVE") // ACTIVE | CLOSED | CANCELLED
  result     String? // TP | SL | MANUAL
  createdBy  String?
  user       User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  closedAt   DateTime?

  @@index([status, createdAt])
}

model Conversation {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  messages      Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole     String // USER | ADMIN
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model BotConfig {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  running        Boolean  @default(false)
  riskPercent    Float    @default(1.0)
  maxDailyLoss   Float    @default(3.0)
  autoExecute    Boolean  @default(false)
  winRate        Float    @default(0)
  pnl            Float    @default(0)
  tradesToday    Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
